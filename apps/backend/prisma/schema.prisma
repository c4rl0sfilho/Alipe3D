// Alipe3D Manager — schema Prisma
// Modelos adicionados fase a fase, sempre via migrations versionadas (npm run db:migrate).
// DER completo e decisões de modelagem: docs/ARQUITETURA.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// Usuários, perfis e permissões (Fase 2)
// =====================================================================

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String    @db.VarChar(120)
  /// Sempre armazenado em minúsculas.
  email               String    @unique @db.VarChar(160)
  passwordHash        String    @map("password_hash") @db.VarChar(100)
  roleId              String    @map("role_id") @db.Uuid
  isActive            Boolean   @default(true) @map("is_active")
  /// Obriga a troca de senha no próximo acesso (senha provisória definida pelo administrador).
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[] @relation("ResetTokenOwner")
  createdResetTokens  PasswordResetToken[] @relation("ResetTokenCreator")
  auditLogs           AuditLog[]
  uploadedFiles       ProductFile[]
  movements           InventoryMovement[]  @relation("MovementUser")
  maintenances        PrinterMaintenance[]
  ordersResponsible   ProductionOrder[]    @relation("OrderResponsible")
  ordersCreated       ProductionOrder[]    @relation("OrderCreator")
  jobsStarted         PrintJob[]           @relation("JobStarter")
  jobsFinished        PrintJob[]           @relation("JobFinisher")
  inspections         QualityInspection[]

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Código estável (ADMIN, OPERACIONAL ou gerado para perfis personalizados).
  code        String   @unique @db.VarChar(40)
  name        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(240)
  /// Perfis de sistema não podem ser excluídos.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String  @id @default(uuid(7)) @db.Uuid
  /// Formato modulo:acao (ex.: inventory:adjust). Catálogo em packages/shared/src/permissions.ts.
  code      String  @unique @db.VarChar(60)
  module    String  @db.VarChar(40)
  label     String  @db.VarChar(120)
  adminOnly Boolean @default(false) @map("admin_only")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Sessões de longa duração. Guarda apenas o hash SHA-256 do token (o token em si fica só no cookie httpOnly).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// Todas as rotações de uma mesma sessão compartilham a família (detecção de reuso).
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  ip        String?   @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Tokens de uso único para redefinição de senha (armazenados em hash).
model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  /// Preenchido quando o link foi gerado por um administrador.
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("ResetTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ResetTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("password_reset_tokens")
}

// =====================================================================
// Auditoria
// =====================================================================

/// Registro imutável de operações importantes. Nunca é editado nem apagado pela aplicação.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(80)
  entity    String?  @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  /// Detalhes adicionais. Nunca contém senhas ou tokens.
  metadata  Json?
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// =====================================================================
// Catálogo: categorias, produtos, variações, arquivos e ficha técnica (Fase 3)
// =====================================================================

enum ProductStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

enum ProductFileKind {
  IMAGE
  MODEL_STL
  MODEL_3MF
  PRINT_PROFILE
  DOCUMENT
}

model ProductCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("product_categories")
}

/// Produto. Os valores aqui são o padrão herdado pelas variações.
model Product {
  id                    String        @id @default(uuid(7)) @db.Uuid
  sku                   String        @unique @db.VarChar(40)
  name                  String        @db.VarChar(120)
  description           String?
  categoryId            String?       @map("category_id") @db.Uuid
  status                ProductStatus @default(DRAFT)
  salePrice             Decimal       @map("sale_price") @db.Decimal(12, 2)
  estimatedWeightGrams  Decimal       @map("estimated_weight_grams") @db.Decimal(10, 2)
  estimatedPrintMinutes Int           @map("estimated_print_minutes")
  minStock              Decimal       @default(0) @map("min_stock") @db.Decimal(12, 3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Exclusão lógica: o produto some das listas, mas o histórico é preservado.
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(3)

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  files    ProductFile[]

  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

/// Item vendável. Todo produto tem ao menos a variação padrão (isDefault).
/// Campos nulos de preço/peso/tempo/estoque mínimo herdam o valor do produto.
model ProductVariant {
  id                    String    @id @default(uuid(7)) @db.Uuid
  productId             String    @map("product_id") @db.Uuid
  sku                   String    @unique @db.VarChar(40)
  isDefault             Boolean   @default(false) @map("is_default")
  isActive              Boolean   @default(true) @map("is_active")
  color                 String?   @db.VarChar(40)
  material              String?   @db.VarChar(40)
  size                  String?   @db.VarChar(40)
  model                 String?   @db.VarChar(60)
  salePrice             Decimal?  @map("sale_price") @db.Decimal(12, 2)
  estimatedWeightGrams  Decimal?  @map("estimated_weight_grams") @db.Decimal(10, 2)
  estimatedPrintMinutes Int?      @map("estimated_print_minutes")
  minStock              Decimal?  @map("min_stock") @db.Decimal(12, 3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  billOfMaterials  ProductMaterial[]
  stockItem        InventoryItem?
  productionOrders ProductionOrder[]

  @@index([productId])
  @@map("product_variants")
}

model ProductFile {
  id           String          @id @default(uuid(7)) @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  kind         ProductFileKind
  originalName String          @map("original_name") @db.VarChar(200)
  /// Nome gerado pelo sistema no disco (nunca o nome enviado pelo usuário).
  storedName   String          @unique @map("stored_name") @db.VarChar(80)
  mimeType     String          @map("mime_type") @db.VarChar(100)
  sizeBytes    Int             @map("size_bytes")
  isCover      Boolean         @default(false) @map("is_cover")
  uploadedById String?         @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_files")
}

/// Ficha técnica: o que é consumido para fabricar UMA unidade da variação.
/// Exatamente um entre materialId (gramas de filamento) e supplyItemId (unidades de insumo).
model ProductMaterial {
  id           String   @id @default(uuid(7)) @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  materialId   String?  @map("material_id") @db.Uuid
  supplyItemId String?  @map("supply_item_id") @db.Uuid
  quantity     Decimal  @db.Decimal(12, 3)
  notes        String?  @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  material   Material?      @relation(fields: [materialId], references: [id], onDelete: Restrict)
  supplyItem InventoryItem? @relation(fields: [supplyItemId], references: [id], onDelete: Restrict)

  @@unique([variantId, materialId])
  @@unique([variantId, supplyItemId])
  @@index([materialId])
  @@index([supplyItemId])
  @@map("product_materials")
}

// =====================================================================
// Estoque: fornecedores, filamentos, rolos, itens e movimentações (Fase 3)
// =====================================================================

enum MaterialType {
  PLA
  PETG
  ABS
  ASA
  TPU
  PC
  PA
  OTHER
}

enum RollStatus {
  IN_STOCK
  IN_USE
  EMPTY
  DISCARDED
}

enum InventoryItemKind {
  SUPPLY
  FINISHED_GOOD
}

enum SupplyCategory {
  PACKAGING
  LABEL
  NOZZLE
  BUILD_PLATE
  COMPONENT
  OTHER
}

enum StockUnit {
  UN
  PCT
  CX
  M
  ROLO
  KG
  L
}

enum MovementType {
  PURCHASE_IN
  PRODUCTION_OUT
  PRODUCTION_IN
  ADJUSTMENT
  LOSS
  WASTE
  RETURN_IN
  RETURN_OUT
}

model Supplier {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(120)
  document    String?   @db.VarChar(20)
  contactName String?   @map("contact_name") @db.VarChar(120)
  email       String?   @db.VarChar(160)
  phone       String?   @db.VarChar(30)
  website     String?   @db.VarChar(200)
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  rolls          MaterialRoll[]
  inventoryItems InventoryItem[]

  @@map("suppliers")
}

/// Filamento (tipo + fabricante + cor). O estoque físico fica nos rolos.
model Material {
  id            String       @id @default(uuid(7)) @db.Uuid
  name          String       @db.VarChar(120)
  manufacturer  String       @db.VarChar(80)
  type          MaterialType
  color         String       @db.VarChar(40)
  colorHex      String?      @map("color_hex") @db.Char(7)
  minStockGrams Decimal      @default(0) @map("min_stock_grams") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(3)

  rolls            MaterialRoll[]
  productUsages    ProductMaterial[]
  productionOrders ProductionOrder[]

  @@index([type])
  @@map("materials")
}

/// Rolo físico de filamento. Saldo controlado em gramas.
model MaterialRoll {
  id                   String     @id @default(uuid(7)) @db.Uuid
  /// Código sequencial para etiquetar o carretel (R-0001, R-0002...).
  code                 String     @unique @default(dbgenerated("('R-'::text || lpad((nextval('material_roll_code_seq'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  materialId           String     @map("material_id") @db.Uuid
  supplierId           String?    @map("supplier_id") @db.Uuid
  status               RollStatus @default(IN_STOCK)
  initialWeightGrams   Decimal    @map("initial_weight_grams") @db.Decimal(10, 2)
  remainingWeightGrams Decimal    @map("remaining_weight_grams") @db.Decimal(10, 2)
  spoolWeightGrams     Decimal    @map("spool_weight_grams") @db.Decimal(10, 2)
  purchaseCost         Decimal    @map("purchase_cost") @db.Decimal(12, 2)
  purchasedAt          DateTime   @map("purchased_at") @db.Date
  lotNumber            String?    @map("lot_number") @db.VarChar(60)
  notes                String?    @db.VarChar(500)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  material  Material            @relation(fields: [materialId], references: [id], onDelete: Restrict)
  supplier  Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]
  printJobs PrintJob[]

  @@index([materialId, status])
  @@map("material_rolls")
}

/// Insumos (embalagens, etiquetas, bicos...) e produtos acabados (um por variação).
model InventoryItem {
  id               String            @id @default(uuid(7)) @db.Uuid
  kind             InventoryItemKind
  name             String            @db.VarChar(120)
  sku              String?           @db.VarChar(40)
  category         SupplyCategory?
  unit             StockUnit         @default(UN)
  quantity         Decimal           @default(0) @db.Decimal(12, 3)
  minQuantity      Decimal           @default(0) @map("min_quantity") @db.Decimal(12, 3)
  /// Custo médio ponderado por unidade (insumos).
  averageUnitCost  Decimal?          @map("average_unit_cost") @db.Decimal(14, 6)
  supplierId       String?           @map("supplier_id") @db.Uuid
  productVariantId String?           @unique @map("product_variant_id") @db.Uuid
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)

  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  productVariant ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  movements      InventoryMovement[]
  productUsages  ProductMaterial[]

  @@index([kind, deletedAt])
  @@map("inventory_items")
}

/// Livro-razão do estoque. Nunca é editado nem apagado; correções são novos lançamentos.
/// Exatamente um alvo: materialRollId (gramas) ou inventoryItemId (unidades).
model InventoryMovement {
  id                 String       @id @default(uuid(7)) @db.Uuid
  type               MovementType
  materialRollId     String?      @map("material_roll_id") @db.Uuid
  inventoryItemId    String?      @map("inventory_item_id") @db.Uuid
  /// Quantidade com sinal: positiva = entrada, negativa = saída.
  quantity           Decimal      @db.Decimal(12, 3)
  balanceAfter       Decimal      @map("balance_after") @db.Decimal(12, 3)
  unitCost           Decimal?     @map("unit_cost") @db.Decimal(14, 6)
  totalCost          Decimal?     @map("total_cost") @db.Decimal(12, 2)
  reason             String       @db.VarChar(300)
  /// true quando o lançamento deixou o saldo negativo com autorização administrativa.
  negativeAuthorized Boolean      @default(false) @map("negative_authorized")
  /// Origem automática (ex.: ordem de produção, pedido) a partir das próximas fases.
  referenceType      String?      @map("reference_type") @db.VarChar(40)
  referenceId        String?      @map("reference_id") @db.VarChar(64)
  userId             String       @map("user_id") @db.Uuid
  occurredAt         DateTime     @map("occurred_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  materialRoll  MaterialRoll?  @relation(fields: [materialRollId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  user          User           @relation("MovementUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([materialRollId, occurredAt])
  @@index([inventoryItemId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// =====================================================================
// Impressoras e manutenção (Fase 4)
// =====================================================================

/// Situação cadastrada. "Imprimindo"/"Pausada" vêm da impressão em andamento (PrintJob).
enum PrinterStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  CLEANING
  CALIBRATION
  PART_REPLACEMENT
  FIRMWARE
  OTHER
}

model Printer {
  id           String        @id @default(uuid(7)) @db.Uuid
  /// Identificação da máquina (ex.: ALIPE-PRINTER-01).
  code         String        @unique @db.VarChar(40)
  name         String?       @db.VarChar(80)
  model        String        @db.VarChar(80)
  serialNumber String?       @map("serial_number") @db.VarChar(80)
  acquiredAt   DateTime?     @map("acquired_at") @db.Date
  /// Horas do contador da impressora no cadastro. O total soma as impressões registradas.
  initialHours Decimal       @default(0) @map("initial_hours") @db.Decimal(10, 1)
  status       PrinterStatus @default(AVAILABLE)
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(3)

  maintenances     PrinterMaintenance[]
  productionOrders ProductionOrder[]
  printJobs        PrintJob[]

  @@map("printers")
}

model PrinterMaintenance {
  id                String          @id @default(uuid(7)) @db.Uuid
  printerId         String          @map("printer_id") @db.Uuid
  type              MaintenanceType
  description       String          @db.VarChar(500)
  performedAt       DateTime        @map("performed_at") @db.Date
  /// Quem executou (pode ser alguém de fora do sistema, como um técnico).
  responsibleName   String          @map("responsible_name") @db.VarChar(120)
  partsReplaced     String?         @map("parts_replaced") @db.VarChar(500)
  cost              Decimal         @default(0) @db.Decimal(12, 2)
  nextMaintenanceAt DateTime?       @map("next_maintenance_at") @db.Date
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Restrict)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([printerId, performedAt])
  @@map("printer_maintenances")
}

// =====================================================================
// Produção: ordens, impressões e inspeção (Fase 4)
// =====================================================================

enum ProductionStatus {
  PENDING
  PLANNED
  IN_PROGRESS
  PAUSED
  FAILED
  COMPLETED
  INSPECTION
  APPROVED
  CANCELLED
}

/// A ordem de declaração define a ordenação (URGENT é a maior).
enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PrintJobStatus {
  IN_PROGRESS
  PAUSED
  SUCCEEDED
  FAILED
}

enum FailureReason {
  BED_ADHESION
  NOZZLE_CLOG
  FILAMENT_RUNOUT
  FILAMENT_TANGLE
  LAYER_SHIFT
  WARPING
  SPAGHETTI
  POWER_OUTAGE
  SLICING_ERROR
  OPERATOR_CANCELLED
  OTHER
}

/// Ordem de produção de UMA variação. Um pedido (Fase 5) gera uma ordem por item.
model ProductionOrder {
  id                   String             @id @default(uuid(7)) @db.Uuid
  /// Código sequencial (OP-0001, OP-0002...).
  code                 String             @unique @default(dbgenerated("('OP-'::text || lpad((nextval('production_order_code_seq'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  variantId            String             @map("variant_id") @db.Uuid
  materialId           String?            @map("material_id") @db.Uuid
  printerId            String?            @map("printer_id") @db.Uuid
  quantity             Int
  /// Peças saídas da impressora (somadas a cada impressão concluída).
  producedQuantity     Int                @default(0) @map("produced_quantity")
  approvedQuantity     Int                @default(0) @map("approved_quantity")
  rejectedQuantity     Int                @default(0) @map("rejected_quantity")
  /// Peças dispensadas: reprovadas sem refabricação, falhas sem refazer ou o que faltava ao encerrar.
  waivedQuantity       Int                @default(0) @map("waived_quantity")
  status               ProductionStatus   @default(PENDING)
  priority             ProductionPriority @default(NORMAL)
  dueDate              DateTime?          @map("due_date") @db.Date
  estimatedMinutes     Int                @map("estimated_minutes")
  estimatedWeightGrams Decimal            @map("estimated_weight_grams") @db.Decimal(10, 2)
  notes                String?
  cancelReason         String?            @map("cancel_reason") @db.VarChar(300)
  responsibleId        String             @map("responsible_id") @db.Uuid
  createdById          String             @map("created_by_id") @db.Uuid
  /// Quando a ordem foi encerrada (aprovada, falhou ou cancelada).
  closedAt             DateTime?          @map("closed_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  material    Material?           @relation(fields: [materialId], references: [id], onDelete: Restrict)
  printer     Printer?            @relation(fields: [printerId], references: [id], onDelete: Restrict)
  responsible User                @relation("OrderResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  printJobs   PrintJob[]
  inspections QualityInspection[]

  @@index([status, priority])
  @@index([printerId, status])
  @@index([materialId])
  @@index([variantId])
  @@map("production_orders")
}

/// Cada execução numa impressora: é o histórico de impressão e de falhas.
/// A baixa de filamento é feita ao finalizar, no livro-razão (referenceType = PRINT_JOB).
model PrintJob {
  id                String         @id @default(uuid(7)) @db.Uuid
  productionOrderId String         @map("production_order_id") @db.Uuid
  printerId         String         @map("printer_id") @db.Uuid
  /// Rolo carregado no início da impressão.
  rollId            String         @map("roll_id") @db.Uuid
  status            PrintJobStatus @default(IN_PROGRESS)
  plannedQuantity   Int            @map("planned_quantity")
  producedQuantity  Int            @default(0) @map("produced_quantity")
  estimatedGrams    Decimal        @map("estimated_grams") @db.Decimal(10, 2)
  estimatedMinutes  Int            @map("estimated_minutes")
  startedAt         DateTime       @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?      @map("finished_at") @db.Timestamptz(3)
  pausedAt          DateTime?      @map("paused_at") @db.Timestamptz(3)
  /// Tempo total em pausa, descontado das horas de máquina.
  pausedSeconds     Int            @default(0) @map("paused_seconds")
  failureReason     FailureReason? @map("failure_reason")
  failureNotes      String?        @map("failure_notes") @db.VarChar(500)
  lostMinutes       Int?           @map("lost_minutes")
  needsReprint      Boolean        @default(false) @map("needs_reprint")
  notes             String?        @db.VarChar(1000)
  startedById       String         @map("started_by_id") @db.Uuid
  finishedById      String?        @map("finished_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  printer         Printer         @relation(fields: [printerId], references: [id], onDelete: Restrict)
  roll            MaterialRoll    @relation(fields: [rollId], references: [id], onDelete: Restrict)
  startedBy       User            @relation("JobStarter", fields: [startedById], references: [id], onDelete: Restrict)
  finishedBy      User?           @relation("JobFinisher", fields: [finishedById], references: [id], onDelete: Restrict)

  @@index([printerId, startedAt])
  @@index([productionOrderId])
  @@index([status])
  @@map("print_jobs")
}

/// Inspeção das peças impressas. As aprovadas entram no estoque de produto acabado.
model QualityInspection {
  id                String   @id @default(uuid(7)) @db.Uuid
  productionOrderId String   @map("production_order_id") @db.Uuid
  approvedQuantity  Int      @map("approved_quantity")
  rejectedQuantity  Int      @map("rejected_quantity")
  notes             String?
  inspectedById     String   @map("inspected_by_id") @db.Uuid
  inspectedAt       DateTime @default(now()) @map("inspected_at") @db.Timestamptz(3)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  inspectedBy     User            @relation(fields: [inspectedById], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
  @@map("quality_inspections")
}
