# =============================================================
# Alipe3D Manager — variáveis de ambiente
# Copie para ".env" (na raiz do projeto) e ajuste os valores.
# NUNCA versione o arquivo .env.
# =============================================================

# ---------- Banco de dados (Docker Compose) ----------
POSTGRES_USER=alipe3d
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=alipe3d_manager
POSTGRES_PORT=5432

# URL usada pelo backend/Prisma quando roda FORA do Docker (npm run dev).
# Dentro do Docker Compose o host passa a ser "postgres" (definido no compose).
DATABASE_URL=postgresql://alipe3d:troque-esta-senha@localhost:5432/alipe3d_manager?schema=public

# ---------- Backend ----------
NODE_ENV=development
API_PORT=3333
# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Rate limiting global da API
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Documentação Swagger em /api/docs (recomenda-se false em produção)
SWAGGER_ENABLED=true
# true quando a API estiver atrás de proxy reverso (nginx, Docker)
TRUST_PROXY=false

# ---------- Autenticação ----------
# Segredo de assinatura dos tokens (mínimo 32 caracteres). Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Validade do token de acesso em segundos (900 = 15 min)
JWT_ACCESS_TTL=900
# Validade da sessão em dias (renovada a cada uso)
REFRESH_TOKEN_TTL_DAYS=7
# true em produção com HTTPS
COOKIE_SECURE=false
# Custo do bcrypt (12 recomendado)
BCRYPT_ROUNDS=12
# Tentativas de login/recuperação por IP a cada 15 minutos
AUTH_RATE_LIMIT_MAX=10
# Endereço da interface (usado nos links de redefinição de senha)
APP_URL=http://localhost:5173

# ---------- Arquivos de produtos ----------
# Pasta onde ficam fotos, STL, 3MF e documentos. Vazio = apps/backend/uploads.
# Inclua esta pasta no backup.
UPLOAD_DIR=

# ---------- Primeiro administrador (usado só pelo "npm run db:seed") ----------
# Criado apenas se ainda não houver administrador. A senha é provisória:
# deverá ser trocada no primeiro acesso. Mínimo 8 caracteres, com letras e números.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- E-mail (opcional) ----------
# Sem SMTP, a recuperação de senha funciona pelo link gerado pelo administrador.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Alipe3D Manager <nao-responda@alipe3d.com.br>

# ---------- Frontend ----------
# Porta do servidor de desenvolvimento Vite
WEB_PORT=5173
# Alvo do proxy /api do Vite em desenvolvimento
VITE_API_PROXY_TARGET=http://localhost:3333
